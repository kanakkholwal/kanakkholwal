{
  "name": "porfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env PORTLESS_HTTPS=0 portless",
    "dev:app": "vite dev",
    "dev:list": "portless list",
    "dev:stop": "portless prune",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "test": "bun test",
    "audit:design": "node scripts/audit-design-tokens.mjs",
