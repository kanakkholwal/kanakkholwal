# Worker secrets for local dev: copy to .dev.vars (git-ignored). The Cloudflare Vite
# plugin loads it for `vite dev` and `vite preview`. Production: `wrangler secret put <NAME>`.
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECTS_CE_TOKEN=SOME.SECURE.TOKEN.VALUE.HERE

# GA4 read key. Without it, /analytics shows a no-data banner and project Analytics tabs stay hidden.
# Full service-account JSON on one line (escaped \n inside private_key is fine).
GA_SERVICE_ACCOUNT_KEY={"client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Numeric GA4 property id (overrides project.config.ts analytics.site.propertyId).
GA_SITE_PROPERTY_ID=
