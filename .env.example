# Copy to .env.local (or .env.development / .env.production), same files the Next.js build read.
# Server secrets: names must match wrangler.jsonc `secrets`/`vars`; they never reach the client bundle.
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECTS_CE_TOKEN=SOME.SECURE.TOKEN.VALUE.HERE

# GA4 read key. Without it, /analytics shows a no-data banner and project Analytics tabs stay hidden.
# Full service-account JSON (one line with escaped \n, or a quoted multi-line value).
GA_SERVICE_ACCOUNT_KEY={"client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Numeric GA4 property id (overrides project.config.ts analytics.site.propertyId).
GA_SITE_PROPERTY_ID=

# PostHog personal API key (Settings > Personal API keys), scope "Query: Read", access to the
# Recast and Baby UI projects. Project ids live in project.config.ts. Without it those sections hide.
POSTHOG_PERSONAL_API_KEY=phx_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public, inlined into the client bundle. Cloudflare zone with Image Transformations enabled.
VITE_CF_IMAGE_DOMAIN=
