GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECTS_CE_TOKEN=SOME.SECURE.TOKEN.VALUE.HERE

# Analytics — GA4 read key (server-only). Without these the /analytics page and
# project Analytics tabs fall back to src/data/analytics.json.
# Full service-account JSON on one line (escaped \n inside private_key is fine).
GA_SERVICE_ACCOUNT_KEY={"client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Numeric GA4 property id for the site (overrides project.config.ts analytics.site.propertyId).
GA_SITE_PROPERTY_ID=123456789
